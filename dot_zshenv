# 所有 zsh 都会读取本文件（含脚本和 zsh -c），只放环境变量。

# PATH 自动去重
typeset -U path

# 默认 JDK 25：避免脚本中 Homebrew 的 mvn 回退到它依赖的最新版 openjdk。
# 已有 JAVA_HOME（如父进程用 jdk25 等切换过）时保持不变。
if [[ -z "$JAVA_HOME" && -x /opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home/bin/java ]]; then
  export JAVA_HOME=/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home
fi
[[ -z "$JAVA_HOME" ]] || path=("$JAVA_HOME/bin" $path)
